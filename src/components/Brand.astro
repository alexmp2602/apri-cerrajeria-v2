---
import { Image } from "astro:assets";
import logo from "../assets/apri-symbol.png";
interface Props {
  priority?: boolean;
}
const { priority = false } = Astro.props;
---

<Image
  src={logo}
  alt=""
  width={64}
  widths={[64, 128]}
  sizes="64px"
  format="webp"
  loading={priority ? "eager" : "lazy"}
/>
<span class="brand-wordmark">APRI<small>CERRAJERÍA · MENDOZA</small></span>
