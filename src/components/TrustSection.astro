      <article>
        <Icon name="clock" /><div>
          <h3>Urgencias las 24 horas</h3><p>
            Servicio de urgencias de día y de noche.
          </p>
        </div>
      </article><article>
        <Icon name="shield" /><div>
          <h3>Trabajo responsable</h3><p>
            Herramientas adecuadas y cuidado en cada intervención.
          </p>
        </div>
      </article><article>
        <Icon name="pin" /><div>
          <h3>Servicio local</h3><p>
            Cobertura en Gran Mendoza con contacto directo.
          </p>
        </div>
      </article>
    </div>
  </div>
</section>
