---
import Icon from "./Icon.astro";
import { whatsapp } from "../data/business";
---

<section class="section coverage" id="zona">
  <div class="container coverage-card">
    <div class="coverage-copy">
      <span class="eyebrow light">Zona de cobertura</span><h2>
        Nos movemos por todo<br />Gran Mendoza.
      </h2><p>
        Base en San José y atención a domicilio. Compartí tu ubicación por
        WhatsApp para confirmar disponibilidad.
      </p><a
        class="button button-primary"
        href={whatsapp(
          "Hola APRI, quiero confirmar si llegan a mi ubicación: ",
        )}><Icon name="pin" /> Consultar mi zona</a
      >
    </div><figure class="map-frame">
      <img
        src="/assets/map/gran-mendoza.svg"
        alt="Mapa de las principales vías de Gran Mendoza con APRI señalado en San José, Guaymallén"
        loading="lazy"
        decoding="async"
        width="720"
        height="520"
      /><figcaption>
        Cartografía vial basada en <a
          href="https://www.openstreetmap.org/copyright"
          target="_blank"
          rel="noopener noreferrer">OpenStreetMap</a
        >
      </figcaption>
    </figure>
  </div>
</section>
