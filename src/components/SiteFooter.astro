---
import Icon from "./Icon.astro";
import { business, shopHours, whatsapp } from "../data/business";
import Brand from "./Brand.astro";
---

<footer>
  <div class="container footer-main">
    <div>
      <a class="brand footer-brand" href="#inicio"><Brand /></a><h2>
        Guardá el número.<br />Ojalá no lo necesites.
      </h2>
    </div><div class="footer-contact">
      <span>Contacto directo</span><a href={`tel:${business.phone}`}
        >{business.displayPhone}</a
      ><a href={`mailto:${business.email}`}>{business.email}</a><a
        href={whatsapp("Hola APRI, necesito un servicio de cerrajería.")}
        >WhatsApp <Icon name="arrow" /></a
      >
    </div><div class="footer-contact">
      <span>Local y horarios</span><p>
        Tropero Sosa 360<br />San José, Mendoza
      </p>{
        shopHours.map(({ label, display }) => (
          <p>
            {label}
            <br />
            {display}
          </p>
        ))
      }<p><strong>Urgencias las 24 horas</strong></p>
    </div>
  </div><div class="container footer-bottom">
    <p>© {new Date().getFullYear()} Cerrajería APRI.</p><p>
      Servicio en Gran Mendoza, Argentina.
    </p>
  </div>
</footer>
